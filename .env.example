# The Social Mining Service's URL. During local dev, point this at your
# Cloudflare tunnel (or http://localhost:3001 if running everything locally).
SOCIAL_MINING_API_URL="http://localhost:3001"

# Must match OPS_API_KEY in packages/service/.env exactly.
SOCIAL_MINING_OPS_API_KEY=""

# Password for /login. The allowed emails (and the name each one's actions
# are recorded under) are listed in lib/auth.ts — they share this password
# for now; there's no user database yet.
OPS_DASHBOARD_PASSWORD=""

# Random value stored in the session cookie after a successful login — NOT
# the password itself, so a leaked cookie doesn't leak OPS_DASHBOARD_PASSWORD.
# Generate with: openssl rand -hex 32
OPS_DASHBOARD_SESSION_SECRET=""
